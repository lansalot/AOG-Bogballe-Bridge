<Window x:Class="AOGBogballeBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AOGBogballeBridge"
        x:Name="MainWindowRoot"
        Title="AOG Bogballe Bridge"
        Icon="AgOpenGPS Bogballe.ico"
        Height="800"
        Width="1200"
        MinHeight="650"
        MinWidth="900"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
      <Grid x:Name="FullLayout" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" Margin="0,0,0,10"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Minimal display" Click="ShowMinimalDisplay"
                                Padding="10,4" Margin="8,0,0,0"/>
                        <TextBlock Text="Connection" FontWeight="Bold" FontSize="15"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="COM port or simulator" FontWeight="SemiBold" Margin="0,8,0,3"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Refresh"
                                Command="{Binding RefreshPortsCommand}" Margin="8,0,0,0" Padding="10,3"/>
                        <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>
                    </DockPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="UDP" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Ellipse Grid.Column="1" Width="13" Height="13" Fill="{Binding UdpBrush}"
                                 Margin="6,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ConnectionOutputLabel}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Ellipse Grid.Column="3" Width="13" Height="13" Fill="{Binding SerialBrush}"
                                 Margin="6,0,0,0" VerticalAlignment="Center"
                                 ToolTip="Blue indicates the virtual calibrator; no serial device is used."/>
                    </Grid>
                    <TextBlock Text="{Binding SimulatorStatus}"
                               Visibility="{Binding IsSimulatorMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                               TextWrapping="Wrap" FontSize="11" Foreground="DimGray" Margin="0,6,0,0"/>
                </StackPanel>

                <Grid Grid.Column="1" Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="LightSteelBlue" BorderThickness="1"
                            Background="#EEF5FB" CornerRadius="4" Padding="8,4" Margin="0,0,4,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Speed" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock FontWeight="Bold" FontSize="20" Foreground="DarkSlateBlue"
                                       Margin="8,0,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding Speed, StringFormat='{}{0:F1}'}"/><Run Text=" km/h"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="LightSteelBlue" BorderThickness="1"
                            Background="#EEF5FB" CornerRadius="4" Padding="8,4" Margin="4,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Width" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock FontWeight="Bold" FontSize="20" Foreground="DarkSlateBlue"
                                       Margin="8,0,0,0" VerticalAlignment="Center">
                                <Run Text="{Binding Width, StringFormat='{}{0:F1}'}"/><Run Text=" m"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="LightSteelBlue" BorderThickness="1"
                            Background="#EEF5FB" CornerRadius="4" Padding="8,4" Margin="0,4,4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Target rate" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TargetApplicationRateDisplay, Mode=OneWay}"
                                       FontWeight="Bold" FontSize="20" Foreground="DarkSlateBlue"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="LightSteelBlue" BorderThickness="1"
                            Background="#EEF5FB" CornerRadius="4" Padding="8,4" Margin="4,4,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AOG rate" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                       ToolTip="Value from AgOpenGPS PGN 0xE7, not a measured spreader value."/>
                            <TextBlock Text="{Binding Rate, StringFormat='{}{0:F2} kg/ha', Mode=OneWay}"
                                       FontWeight="Bold" FontSize="18" Foreground="DarkSlateBlue"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       ToolTip="Value from AgOpenGPS PGN 0xE7, not a measured spreader value."/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Live data" FontWeight="Bold" FontSize="15" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding GpsStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding GpsCoordinateText}"/>
                    <TextBlock Text="{Binding RateProtocolStatus}" TextWrapping="Wrap"
                               FontSize="11" Foreground="DimGray" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding ConfigText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12" Margin="0,0,0,10"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Sections" FontWeight="Bold" FontSize="14"/>
                <ItemsControl ItemsSource="{Binding Sections}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="8"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" Height="24" BorderBrush="DarkGray" BorderThickness="1"
                                    CornerRadius="3" Background="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Padding="12" BorderBrush="LightGray" BorderThickness="1"
                CornerRadius="4" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Variable-rate map" FontWeight="Bold" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ShapefileName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="DBF field" Margin="12,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding ShapefileFields}"
                              SelectedItem="{Binding SelectedShapefileField}"/>
                    <Button Grid.Column="4" Content="Load shapefile..."
                            Command="{Binding LoadShapefileCommand}" Padding="12,5" Margin="8,0,0,0"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding ShapefileStatus}" TextWrapping="Wrap"
                               FontSize="11" Foreground="DimGray" Margin="0,0,0,5"/>
                    <Border Grid.Row="1" BorderBrush="DarkGray" BorderThickness="1" CornerRadius="4">
                        <local:ShapefileMap Features="{Binding ShapefileFeatures, Mode=OneWay}"
                                            ValueField="{Binding SelectedShapefileField, Mode=OneWay}"
                                            IsGeographic="{Binding IsShapefileGeographic, Mode=OneWay}"
                                            GpsPositionValid="{Binding GpsPositionValid, Mode=OneWay}"
                                            GpsLatitude="{Binding GpsLatitude, Mode=OneWay}"
                                            GpsLongitude="{Binding GpsLongitude, Mode=OneWay}"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
      </Grid>

      <Grid x:Name="MinimalLayout" Visibility="Collapsed" Background="#FF202830" Margin="4"
            MouseLeftButtonDown="MinimalLayout_MouseLeftButtonDown" Cursor="SizeAll"
            ToolTip="Drag to reposition">
          <Grid.LayoutTransform>
              <ScaleTransform ScaleX="3" ScaleY="3"/>
          </Grid.LayoutTransform>
          <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,24,0">
              <TextBlock Text="SPEED" Foreground="LightGray" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Margin="8,0,0,0" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center">
                  <Run Text="{Binding Speed, StringFormat='{}{0:F1}'}"/><Run Text=" km/h"/>
              </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="WIDTH" Foreground="LightGray" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Margin="8,0,0,0" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center">
                  <Run Text="{Binding Width, StringFormat='{}{0:F1}'}"/><Run Text=" m"/>
              </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0"
                      Visibility="{Binding ShapefileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="RATE" Foreground="LightGray" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding TargetApplicationRateDisplay, Mode=OneWay}"
                         Margin="8,0,0,0" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Grid.Column="3" Click="ShowFullDisplay" Padding="12,6"
                  VerticalAlignment="Center" Margin="12,0,4,0" ToolTip="Return to the full window (Esc)"
                  AutomationProperties.Name="Return to full window">
              <Viewbox Width="16" Height="16" Stretch="Uniform">
                  <Canvas Width="24" Height="24">
                      <Path Data="M 9,3 H 3 V 9 M 15,3 H 21 V 9 M 21,15 V 21 H 15 M 9,21 H 3 V 15"
                            Stroke="Black" StrokeThickness="2" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                  </Canvas>
              </Viewbox>
          </Button>
      </Grid>
    </Grid>
</Window>
