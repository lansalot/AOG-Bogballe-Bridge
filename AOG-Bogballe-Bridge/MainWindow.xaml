<Window x:Class="AOGBogballeBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AOGBogballeBridge"
        x:Name="MainWindowRoot"
        Title="AOG Bogballe Bridge"
        Icon="AgOpenGPS Bogballe.ico"
        Height="800"
        Width="1200"
        MinHeight="650"
        MinWidth="900"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
      <Grid x:Name="FullLayout" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" Margin="0,0,0,6"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="2.35*"/>
                    <ColumnDefinition Width="2.2*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Content="Minimal" Click="ShowMinimalDisplay"
                                Padding="8,3" Margin="6,0,0,0"/>
                        <TextBlock Text="Connection" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1" Margin="0,5,0,0">
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshPortsCommand}"
                                Margin="5,0,0,0" Padding="7,3"/>
                        <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"/>
                    </DockPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="UDP" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Ellipse Width="11" Height="11" Fill="{Binding UdpBrush}" Margin="5,0,12,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionOutputLabel}" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Ellipse Width="11" Height="11" Fill="{Binding SerialBrush}" Margin="5,0,0,0"
                                 VerticalAlignment="Center"
                                 ToolTip="Blue indicates the virtual calibrator; no serial device is used."/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="{Binding SimulatorStatus}"
                               Visibility="{Binding IsSimulatorMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                               TextWrapping="Wrap" FontSize="9" Foreground="DimGray" Margin="0,3,0,0"/>
                </Grid>

                <Grid Grid.Column="1" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Live data" FontWeight="Bold" FontSize="14"/>
                    <UniformGrid Grid.Row="1" Columns="3" Rows="2" Margin="0,3,0,0">
                        <StackPanel Margin="2,0">
                            <TextBlock Text="Speed" FontSize="10" Foreground="DimGray"/>
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="DarkSlateBlue">
                                <Run Text="{Binding Speed, StringFormat='{}{0:F1}'}"/><Run Text=" km/h"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="2,0">
                            <TextBlock Text="Width" FontSize="10" Foreground="DimGray"/>
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="DarkSlateBlue">
                                <Run Text="{Binding Width, StringFormat='{}{0:F1}'}"/><Run Text=" m"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Margin="2,0">
                            <TextBlock Text="Target rate" FontSize="10" Foreground="DimGray"/>
                            <TextBlock Text="{Binding TargetApplicationRateDisplay, Mode=OneWay}"
                                       FontSize="16" FontWeight="Bold" Foreground="DarkSlateBlue"/>
                        </StackPanel>
                        <StackPanel Margin="2,0">
                            <TextBlock Text="Set value" FontSize="10" Foreground="DimGray"
                                       ToolTip="Application rate reported by the Bogballe calibrator."/>
                            <TextBlock Text="{Binding CalibratorSetRateDisplay}" FontSize="16" FontWeight="Bold"
                                       Foreground="DarkSlateBlue"/>
                            <TextBlock Text="{Binding LegacyRateFallbackNote}" FontSize="9" Foreground="DimGray"/>
                        </StackPanel>
                        <StackPanel Margin="2,0">
                            <TextBlock Text="Present value" FontSize="10" Foreground="DimGray"
                                       ToolTip="Present application rate reported by the Bogballe calibrator."/>
                            <TextBlock Text="{Binding CalibratorPresentRateDisplay}" FontSize="16" FontWeight="Bold"
                                       Foreground="DarkSlateBlue"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Grid.Row="2" Text="{Binding GpsStatus}" FontSize="10" Foreground="DimGray"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding GpsCoordinateText}"/>
                    <TextBlock Grid.Row="3" Text="{Binding RateProtocolStatus}" FontSize="9"
                               Foreground="DimGray" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RateProtocolStatus}"/>
                    <TextBlock Grid.Row="4" Text="{Binding ConfigText}" FontSize="9"
                               Foreground="DimGray" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ConfigText}"/>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="Variable-rate map" FontWeight="Bold" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Load shapefile..."
                                Command="{Binding LoadShapefileCommand}" Padding="8,3"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding ShapefileName}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <DockPanel Grid.Row="2" Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="DBF field" FontSize="11"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding ShapefileFields}"
                                  SelectedItem="{Binding SelectedShapefileField}"/>
                    </DockPanel>
                    <TextBlock Grid.Row="3" Text="{Binding ShapefileStatus}" FontSize="10"
                               Foreground="DimGray" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ShapefileStatus}" Margin="0,3,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="6" Margin="0,0,0,6"
                BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Sections" FontWeight="Bold" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" Columns="8"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" Height="14" BorderBrush="DarkGray" BorderThickness="1"
                                    CornerRadius="2" Background="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1"
                CornerRadius="4" ClipToBounds="True">
            <local:ShapefileMap Features="{Binding ShapefileFeatures, Mode=OneWay}"
                                ValueField="{Binding SelectedShapefileField, Mode=OneWay}"
                                IsGeographic="{Binding IsShapefileGeographic, Mode=OneWay}"
                                GpsPositionValid="{Binding GpsPositionValid, Mode=OneWay}"
                                GpsLatitude="{Binding GpsLatitude, Mode=OneWay}"
                                GpsLongitude="{Binding GpsLongitude, Mode=OneWay}"/>
        </Border>
      </Grid>

      <Grid x:Name="MinimalLayout" Visibility="Collapsed" Background="#FF202830" Margin="4"
            MouseLeftButtonDown="MinimalLayout_MouseLeftButtonDown" Cursor="SizeAll"
            ToolTip="Drag to reposition">
          <Grid.LayoutTransform>
              <ScaleTransform ScaleX="3" ScaleY="3"/>
          </Grid.LayoutTransform>
          <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,24,0">
              <TextBlock Text="SPEED" Foreground="LightGray" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Margin="8,0,0,0" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center">
                  <Run Text="{Binding Speed, StringFormat='{}{0:F1}'}"/><Run Text=" km/h"/>
              </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
              <TextBlock Text="WIDTH" Foreground="LightGray" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Margin="8,0,0,0" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center">
                  <Run Text="{Binding Width, StringFormat='{}{0:F1}'}"/><Run Text=" m"/>
              </TextBlock>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0"
                      Visibility="{Binding ShapefileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="RATE" Foreground="LightGray" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding TargetApplicationRateDisplay, Mode=OneWay}"
                         Margin="8,0,0,0" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Grid.Column="3" Click="ShowFullDisplay" Padding="12,6"
                  VerticalAlignment="Center" Margin="12,0,4,0" ToolTip="Return to the full window (Esc)"
                  AutomationProperties.Name="Return to full window">
              <Viewbox Width="16" Height="16" Stretch="Uniform">
                  <Canvas Width="24" Height="24">
                      <Path Data="M 9,3 H 3 V 9 M 15,3 H 21 V 9 M 21,15 V 21 H 15 M 9,21 H 3 V 15"
                            Stroke="Black" StrokeThickness="2" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                  </Canvas>
              </Viewbox>
          </Button>
      </Grid>
    </Grid>
</Window>
